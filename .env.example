# TekLive Rest — backend API
# Default points to the local BusinessSuite API (dotnet run --urls http://127.0.0.1:5171).
VITE_API_BASE_URL=http://127.0.0.1:5171

# Rest module shared key (AppApiKeyMiddleware → RestAppApiKey in appsettings.Development.json).
# Production value must be injected at build/deploy time — never commit real secrets.
VITE_APP_API_KEY=dev-rest-api-key-local
