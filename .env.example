# TekLive Rest — backend API
# Default points to the local BusinessSuite API (dotnet run --urls http://127.0.0.1:5171).
VITE_API_BASE_URL=http://127.0.0.1:5171

# Rest module shared key (AppApiKeyMiddleware → RestAppApiKey).
# Sin default en el codigo: si falta, el cliente no envia X-Api-Key y recibe 401.
# En produccion se inyecta en build/deploy — nunca se versiona el valor real.
VITE_APP_API_KEY=
