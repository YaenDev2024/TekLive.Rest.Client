<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Android 12+ (API 31) reemplaza el splash por una ventana del sistema
        con su propia mascara. Se declaran aqui los atributos nativos ademas de
        los de la libreria para que el sistema no dependa de los defaults del
        tema y no salga el icono de la app generico ni el fondo blanco.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
